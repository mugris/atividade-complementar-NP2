algoritmo "InsertionSort"
var
   v: vetor[0..10] de inteiro
   i, j, chave, n: inteiro
inicio
   n <- 10
   para i de 1 ate n faca
      escreva("Digite o valor ", i, ": ")
      leia(v[i])
   fimpara
   para i de 2 ate n faca
      chave <- v[i]
      j <- i - 1
      enquanto (j >= 1) e (v[j] > chave) faca
         v[j+1] <- v[j]
         j <- j - 1
      fimenquanto
      v[j+1] <- chave
   fimpara
   escreval("Vetor ordenado:")
   para i de 1 ate n faca
      escreva(v[i], " ")
   fimpara
fimalgoritmo